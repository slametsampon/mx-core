{
  "name": "mx-core",
  "private": true,
  "version": "0.6.1",
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "npm run dev -w apps/frontend",
    "build": "npm run build:manifest && npm run export:docs && npm run build:frontend && npm run export:frontend",
    "build:frontend": "npm run --workspace=apps/frontend build",
    "export:frontend": "npm run --workspace=apps/frontend export && node scripts/post-export-move.js",
    "preview:frontend": "serve apps/frontend/out",
    "build:docs": "npm run build -w mx-core-docs",
    "build:manifest": "ts-node scripts/generate-plugin-manifest.ts",
    "build:turbo": "npm run build:manifest && turbo run build",
    "build:local": "ts-node scripts/build-local.ts",
    "build:gh-pages": "ts-node scripts/build-gh-pages.ts",
    "lint": "eslint --fix apps/**/*.{js,ts,jsx,tsx} plugins/**/*.{js,ts,jsx,tsx}",
    "format": "prettier --write .",
    "export:docs": "npm run --workspace=plugins/mx-core-docs export",
    "deploy:docs": "npm run export:docs && gh-pages -d plugins/mx-core-docs/out"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@types/express": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^8.45.0",
    "eslint-config-next": "13.5.6",
    "eslint-config-prettier": "^8.8.0",
    "fs-extra": "^11.3.2",
    "gh-pages": "^6.3.0",
    "prettier": "2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.6.1",
    "typescript": "5.0.4"
  },
  "ts-node": {
    "compilerOptions": {
      "baseUrl": ".",
      "paths": {
        "@mx-core/core": [
          "packages/core/src"
        ]
      }
    }
  }
}
