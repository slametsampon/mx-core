{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["components/*"],
      "@/services/*": ["services/*"],
      "@/lib/*": ["lib/*"],
      "@/data/*": ["data/*"],
      "@/styles/*": ["styles/*"],
      "@mx-core/ui": ["../../packages/ui/dist"],
      "@mx-core/ui/*": ["../../packages/ui/dist/*"]
    },
    "noEmit": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
