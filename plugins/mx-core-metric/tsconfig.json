{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true, // ⬅️ Direkomendasikan
    "declarationMap": true,
    "rootDir": "src", // ⬅️ Tambahkan ini
    "outDir": "dist",
    "baseUrl": "src", // penting
    "paths": {
      "@/components/*": ["components/*"],
      "@/app/*": ["app/*"],
      "@/models/*": ["models/*"],
      "@/services/*": ["services/*"],
      "@/lib/*": ["lib/*"],
      "@/css/*": ["css/*"],
      "@/data/*": ["data/*"],
      "@/mocks/*": ["mocks/*"]
    },
    "noEmit": true
  },
  "include": ["src", ".next/types/**/*.ts"],
  "references": [
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/core"
    }
  ],
  "exclude": ["node_modules"]
}
