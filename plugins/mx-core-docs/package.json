{
  "name": "mx-core-docs",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:docs": "cross-env GITHUB_PAGES=true contentlayer build && next build",
    "start": "next start",
    "export": "next export",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir src/app --dir src/components --dir src/content",
    "format": "prettier --write .",
    "build:ts": "tsc -p tsconfig.build.json",
    "clean": "powershell -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next }; if (Test-Path out) { Remove-Item -Recurse -Force out }\""
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "18.16.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.1",
    "@vercel/analytics": "^1.0.0",
    "autoprefixer": "10.4.14",
    "contentlayer": "^0.3.2",
    "katex": "^0.16.23",
    "next": "13.4.1",
    "next-contentlayer": "^0.3.2",
    "next-themes": "^0.2.1",
    "pliny": "^0.4.1",
    "postcss": "8.4.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^6.1.0",
    "rehype-citation": "^1.0.3",
    "rehype-katex": "^6.0.3",
    "rehype-preset-minify": "^6.0.0",
    "rehype-prism-plus": "^1.6.3",
    "rehype-slug": "^5.1.0",
    "remark": "^14.0.3",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@svgr/webpack": "^8.1.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-config-next": "13.5.6",
    "eslint-config-prettier": "^8.8.0",
    "lint-staged": "^13.3.0",
    "prettier": "2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1"
  }
}
