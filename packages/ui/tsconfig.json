{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@mx-core/core": ["../../packages/core/dist"],
      "@mx-core/core/*": ["../../packages/core/dist/*"],
      "@mx-core/types": ["../../packages/types/dist"],
      "@mx-core/types/*": ["../../packages/types/dist/*"]
    }
  },

  "include": ["src"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/types" }
  ]
}
