{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declarationMap": true,
    "declaration": true,
    "composite": true,
    // Tambahkan kembali alias ini
    "baseUrl": ".",
    "paths": {
      "@mx-core/core": ["src"],
      "@mx-core/core/*": ["src/*"],
      "@mx-core/types": ["../types/dist"],
      "@mx-core/types/*": ["../types/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../types" }]
}
