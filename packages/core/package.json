{
  "name": "@mx-core/core",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rbac": {
      "import": "./dist/rbac/index.js",
      "require": "./dist/rbac/index.js",
      "types": "./dist/rbac/index.d.ts"
    },
    "./rbac/init": {
      "import": "./dist/rbac/init.js",
      "require": "./dist/rbac/init.js",
      "types": "./dist/rbac/init.d.ts"
    },
    "./rbac/policy": {
      "import": "./dist/rbac/policy.js",
      "require": "./dist/rbac/policy.js",
      "types": "./dist/rbac/policy.d.ts"
    },
    "./rbac/rules": {
      "import": "./dist/rbac/rules.js",
      "require": "./dist/rbac/rules.js",
      "types": "./dist/rbac/rules.d.ts"
    }
  },
  "scripts": {
    "clean": "echo clean skipped",
    "build": "npm run clean && tsc --build tsconfig.json --force"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.0.4"
  }
}
