{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@mx-core/core": ["packages/core/dist"],
      "@mx-core/core/*": ["packages/core/dist/*"],
      "@mx-core/ui": ["packages/ui/src"],
      "@mx-core/utils": ["packages/utils/src"],
      "@mx-core/types": ["packages/types/src"],
      "@mx-core/docs": ["plugins/mx-core-docs/src"],
      "@mx-core/metric": ["plugins/mx-core-metric/src"],
      "@mx-core/rbm": ["plugins/mx-core-rbm/src"]
    },
    "plugins": [{ "name": "next" }]
  },
  "references": [
    { "path": "packages/types" },
    { "path": "packages/core" },
    { "path": "packages/ui" },
    { "path": "packages/utils" },
    { "path": "plugins/mx-core-docs" },
    { "path": "plugins/mx-core-metric" },
    { "path": "plugins/mx-core-rbm" }
  ]
}
