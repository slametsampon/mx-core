{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": false,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@mx-core/core": ["packages/core/src"],
      "@mx-core/docs/*": ["plugins/mx-core-docs/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "references": [
    { "path": "packages/core" },
    { "path": "plugins/mx-core-docs" }
  ]
}
